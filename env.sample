# MQTT broker host and port
MQTT_HOST=master
MQTT_PORT=1883

# Topic prefix containing the weather readings
MQTT_TOPIC_PREFIX=house/wx/

# Seconds to wait for readings from the broker
MQTT_TIMEOUT=10

# The latitude of your weather station, in decimal degrees
STATION_LAT_DEG=37.793400

# The longitude of your weather station, in decimal degrees
STATION_LONG_DEG=-122.399776
